# ══════════════════════════════════════════════════════════════
# PASIHAI — Environment Variables (Mfano)
#
# Nakili faili hii kuwa .env.local na ujaze thamani halisi:
#   cp .env.example .env.local
#
# .env.local HAIFUATILIIWI na Git (tazama .gitignore).
# USIWEKE secrets halisi kwenye .env.example wala .env.
# ══════════════════════════════════════════════════════════════

# Supabase project URL (kutoka Supabase Dashboard → Settings → API)
# Mfano: https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/publishable key (kutoka Dashboard → Settings → API)
# HII NI SALAMA kwa browser — RLS ndio ulinzi wa kweli.
# USITUMIE service_role key hapa (ni ya server pekee).
VITE_SUPABASE_PUBLISHABLE_KEY=

# KANUNI: ukiweka URL na key, lazima VITE_SUPABASE_MODE=live. Mode 'mock' pamoja na URL/key
# ni kosa, app inaonyesha ujumbe badala ya kupakia mock kimya kimya.
# Ili uwe mock tu, acha URL na key tupu.
# Hali ya mfumo: 'mock' (default) au 'live'
# - 'mock': repositories zinarudisha mock data (salama, hakuna DB inahitajika)
# - 'live': repositories zinatuma queries kwa Supabase (inahitaji schema + RLS)
# Usibadilishe kuwa 'live' mpaka schema na RLS ziwe tayari.
VITE_SUPABASE_MODE=mock

# ══════════════════════════════════════════════════════════════
# CLOUDINARY (picha/video za Posts na Status) — majina tu, si thamani halisi
#
# Frontend (VITE_*): cloud name na unsigned upload preset si siri, lakini
# zote mbili lazima ziwepo au zisiwepo. Ukiweka moja tu, upload inakataliwa.
# Weka tu baada ya kukagua mipangilio ya preset kwenye Cloudinary (tazama docs/CLOUDINARY-SETUP.md).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Backend ONLY: API secret HAIWEKWI hapa, si kwenye VITE_*, si kwenye React, si GitHub.
# Itatumika tu na backend ya signed upload (bado haijajengwa). Usiweke thamani hapa.
# CLOUDINARY_URL=
# ══════════════════════════════════════════════════════════════
