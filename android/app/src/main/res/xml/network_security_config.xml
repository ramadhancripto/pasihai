<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS-only for app HTTP stacks (Supabase). LAN mesh uses raw TCP sockets, not this stack. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
